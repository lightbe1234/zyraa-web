generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql"
url = env("DATABASE_URL") }

enum Role { CUSTOMER STAFF ADMIN }
enum ProductStatus { DRAFT ACTIVE ARCHIVED }
enum OrderStatus { PENDING CONFIRMED PROCESSING PACKED SHIPPED DELIVERED CANCELLED RETURN_REQUESTED RETURNED }
enum PaymentStatus { PENDING AWAITING_PAYMENT PAID FAILED PARTIALLY_REFUNDED REFUNDED }
enum PaymentMethod { COD BANK_TRANSFER }

model User {
  id String @id @default(cuid())
  email String @unique
  passwordHash String?
  role Role @default(CUSTOMER)
  profile CustomerProfile?
  addresses Address[]
  sessions Session[]
  orders Order[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model Session { id String @id @default(cuid())
tokenHash String @unique
userId String
expiresAt DateTime
user User @relation(fields:[userId],references:[id],onDelete:Cascade)
createdAt DateTime @default(now())
@@index([userId,expiresAt]) }
model VerificationToken { id String @id @default(cuid())
identifier String
tokenHash String @unique
expiresAt DateTime
createdAt DateTime @default(now())
@@index([identifier,expiresAt]) }
model CustomerProfile { id String @id @default(cuid())
userId String @unique
firstName String?
lastName String?
phone String?
user User @relation(fields:[userId],references:[id],onDelete:Cascade)
createdAt DateTime @default(now())
updatedAt DateTime @updatedAt }
model Address { id String @id @default(cuid())
userId String
label String?
firstName String
lastName String
line1 String
line2 String?
city String
province String?
postalCode String?
country String
phone String
user User @relation(fields:[userId],references:[id],onDelete:Cascade)
createdAt DateTime @default(now())
updatedAt DateTime @updatedAt
@@index([userId]) }
model Category { id String @id @default(cuid())
slug String @unique
name String
description String?
imageUrl String?
archivedAt DateTime?
products Product[]
createdAt DateTime @default(now())
updatedAt DateTime @updatedAt }
model Collection { id String @id @default(cuid())
slug String @unique
name String
description String?
imageUrl String?
archivedAt DateTime?
products CollectionProduct[]
createdAt DateTime @default(now())
updatedAt DateTime @updatedAt }
model Product { id String @id @default(cuid())
slug String @unique
name String
shortDescription String?
description String
status ProductStatus @default(DRAFT)
basePrice Int
compareAtPrice Int?
categoryId String
category Category @relation(fields:[categoryId],references:[id])
variants ProductVariant[]
images ProductImage[]
collections CollectionProduct[]
reviews Review[]
publishedAt DateTime?
createdAt DateTime @default(now())
updatedAt DateTime @updatedAt
@@index([status,publishedAt])
@@index([categoryId,status]) }
model CollectionProduct { collectionId String
productId String
position Int @default(0)
collection Collection @relation(fields:[collectionId],references:[id],onDelete:Cascade)
product Product @relation(fields:[productId],references:[id],onDelete:Cascade)
@@id([collectionId,productId])
@@index([collectionId,position]) }
model ProductVariant { id String @id @default(cuid())
productId String
sku String @unique
options Json
priceOverride Int?
stock Int @default(0)
lowStockThreshold Int @default(3)
product Product @relation(fields:[productId],references:[id],onDelete:Cascade)
cartItems CartItem[]
movements InventoryMovement[]
createdAt DateTime @default(now())
updatedAt DateTime @updatedAt
@@index([productId])
@@index([stock]) }
model ProductImage { id String @id @default(cuid())
productId String
url String
storageKey String?
alt String
position Int @default(0)
featured Boolean @default(false)
product Product @relation(fields:[productId],references:[id],onDelete:Cascade)
createdAt DateTime @default(now())
updatedAt DateTime @updatedAt
@@index([productId,position]) }
model InventoryMovement { id String @id @default(cuid())
variantId String
delta Int
reason String
actorId String?
orderId String?
variant ProductVariant @relation(fields:[variantId],references:[id])
createdAt DateTime @default(now())
@@index([variantId,createdAt])
@@index([orderId]) }
model Cart { id String @id @default(cuid())
opaqueTokenHash String @unique
userId String?
items CartItem[]
expiresAt DateTime
createdAt DateTime @default(now())
updatedAt DateTime @updatedAt
@@index([userId])
@@index([expiresAt]) }
model CartItem { id String @id @default(cuid())
cartId String
variantId String
quantity Int
cart Cart @relation(fields:[cartId],references:[id],onDelete:Cascade)
variant ProductVariant @relation(fields:[variantId],references:[id])
@@unique([cartId,variantId]) }
model Coupon { id String @id @default(cuid())
code String @unique
percentOff Int?
amountOff Int?
active Boolean @default(true)
startsAt DateTime?
endsAt DateTime?
createdAt DateTime @default(now())
updatedAt DateTime @updatedAt }
model Order { id String @id @default(cuid())
publicToken String @unique
orderNumber String @unique
idempotencyKeyHash String @unique
userId String?
email String
phone String
status OrderStatus @default(PENDING)
subtotal Int
discount Int
shipping Int
tax Int
fee Int
total Int
user User? @relation(fields:[userId],references:[id])
items OrderItem[]
addresses OrderAddress[]
payment Payment?
history OrderStatusHistory[]
createdAt DateTime @default(now())
updatedAt DateTime @updatedAt
@@index([status,createdAt])
@@index([email,createdAt])
@@index([phone,createdAt]) }
model OrderItem { id String @id @default(cuid())
orderId String
productName String
sku String
options Json
imageUrl String?
unitPrice Int
quantity Int
lineTotal Int
order Order @relation(fields:[orderId],references:[id],onDelete:Restrict)
@@index([orderId]) }
model OrderAddress { id String @id @default(cuid())
orderId String
kind String
firstName String
lastName String
line1 String
line2 String?
city String
province String?
postalCode String?
country String
phone String
order Order @relation(fields:[orderId],references:[id],onDelete:Restrict)
@@index([orderId]) }
model OrderStatusHistory { id String @id @default(cuid())
orderId String
status OrderStatus
actorId String?
note String?
order Order @relation(fields:[orderId],references:[id],onDelete:Restrict)
createdAt DateTime @default(now())
@@index([orderId,createdAt]) }
model Payment { id String @id @default(cuid())
orderId String @unique
method PaymentMethod
status PaymentStatus
amount Int
reference String?
order Order @relation(fields:[orderId],references:[id],onDelete:Restrict)
createdAt DateTime @default(now())
updatedAt DateTime @updatedAt
@@index([status,createdAt]) }
model Review { id String @id @default(cuid())
productId String
rating Int
title String?
body String
authorName String
verified Boolean @default(false)
published Boolean @default(false)
product Product @relation(fields:[productId],references:[id],onDelete:Restrict)
createdAt DateTime @default(now())
updatedAt DateTime @updatedAt
@@index([productId,published,createdAt]) }
model ShippingMethod { id String @id @default(cuid())
code String @unique
name String
price Int
freeThreshold Int?
estimateLabel String
active Boolean @default(true)
createdAt DateTime @default(now())
updatedAt DateTime @updatedAt }
model HomepageSection { id String @id @default(cuid())
type String
position Int
enabled Boolean @default(true)
content Json
createdAt DateTime @default(now())
updatedAt DateTime @updatedAt
@@index([enabled,position]) }
model SiteSetting { key String @id
value Json
updatedAt DateTime @updatedAt }
model NewsletterSubscriber { id String @id @default(cuid())
email String @unique
createdAt DateTime @default(now()) }
model ContactMessage { id String @id @default(cuid())
publicToken String @unique
email String
subject String
body String
createdAt DateTime @default(now())
@@index([createdAt]) }
model NavigationMenu { id String @id @default(cuid())
handle String @unique
items Json
updatedAt DateTime @updatedAt }
model AuditLog { id String @id @default(cuid())
actorId String?
action String
entityType String
entityPublicRef String?
metadata Json?
createdAt DateTime @default(now())
@@index([action,createdAt])
@@index([entityType,entityPublicRef]) }

